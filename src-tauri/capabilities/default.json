{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window (127.0.0.1 local UI)",
  "windows": ["main", "live-anchor"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://127.0.0.1:*/*",
      "http://localhost:*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "allow-list-images",
    "allow-delete-image",
    "allow-get-thumbnail",
    "allow-vault-status",
    "allow-vault-setup",
    "allow-vault-unlock",
    "allow-vault-lock",
    "allow-vault-list",
    "allow-vault-upsert",
    "allow-vault-delete",
    "allow-vault-clear-destroyed",
    "allow-sfx-list-devices",
    "allow-sfx-list-input-devices",
    "allow-sfx-set-device",
    "allow-sfx-set-master-volume",
    "allow-sfx-set-bgm-volume",
    "allow-sfx-set-sfx-volume",
    "allow-sfx-set-tagged-volume",
    "allow-sfx-set-bgm-speed",
    "allow-sfx-set-bgm-pitch",
    "allow-sfx-set-fade-ms",
    "allow-sfx-set-interrupt",
    "allow-sfx-set-duck",
    "allow-sfx-set-voice-duck",
    "allow-sfx-set-loop-mode",
    "allow-sfx-set-playlist",
    "allow-sfx-stop-all",
    "allow-sfx-stop-sfx",
    "allow-sfx-stop-bgm",
    "allow-sfx-pause-bgm",
    "allow-sfx-resume-bgm",
    "allow-sfx-seek-bgm",
    "allow-sfx-play",
    "allow-sfx-test-tone",
    "allow-sfx-render-clip-fx",
    "allow-sfx-play-bgm",
    "allow-sfx-bgm-status",
    "allow-sfx-probe",
    "allow-sfx-transcode",
    "allow-sfx-waveform",
    "allow-sfx-scan-library",
    "allow-sfx-import-files",
    "allow-sfx-delete-file",
    "allow-sfx-category-create",
    "allow-sfx-category-rename",
    "allow-sfx-category-delete",
    "allow-sfx-move-file",
    "allow-sfx-record-start",
    "allow-sfx-record-stop",
    "allow-sfx-record-status",
    "allow-sfx-export-range",
    "allow-sfx-export-montage",
    "allow-obs-configure",
    "allow-obs-connect",
    "allow-obs-status",
    "allow-obs-set-scene",
    "allow-obs-sync-media-seek",
    "allow-obs-disconnect",
    "allow-midi-list-ports",
    "allow-midi-status",
    "allow-midi-configure",
    "allow-midi-send-position",
    "allow-live-open-login",
    "allow-live-bootstrap",
    "allow-live-fetch-login-qr",
    "allow-live-auth-status",
    "allow-live-sync-history",
    "allow-live-sync-deep",
    "allow-live-sync-portrait",
    "allow-live-close-window",
    "allow-live-hide-window",
    "allow-live-show-window",
    "allow-live-current-url",
    "allow-live-scrape",
    "allow-vcam-status",
    "allow-vcam-list-sources",
    "allow-vcam-preview",
    "allow-vcam-install",
    "allow-vcam-uninstall",
    "allow-vcam-start",
    "allow-vcam-push-jpeg",
    "allow-vcam-stop",
    "opener:default",
    "dialog:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "store:default",
    "autostart:default",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    }
  ]
}
