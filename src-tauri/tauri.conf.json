{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FLYBOX",
  "version": "0.1.8",
  "identifier": "com.flyashaw.flyphoto",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "vendor/bass/*",
      "vendor/ffmpeg/ffmpeg.exe",
      "vendor/ffmpeg/ffprobe.exe",
      "resources/vcam/flybox-virtualcam-module64.dll",
      "resources/beauty/beauty_worker.py",
      "resources/beauty/beauty_face_worker.py",
      "resources/beauty/face_landmarker.task",
      "resources/beauty/gpupixel/gpupixel_worker.exe",
      "resources/beauty/gpupixel/gpupixel.dll",
      "resources/beauty/gpupixel/glfw3.dll",
      "resources/beauty/gpupixel/models/*",
      "resources/beauty/gpupixel/res/*"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
